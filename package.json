{
  "name": "toktickit",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "audit:docs:lab4": "node scripts/verify-lab4-docs.mjs",
    "test:release-tools:lab4": "node --test scripts/tests/lab4-release-tools.test.mjs",
    "verify:release:lab4": "node scripts/verify-lab4-release.mjs",
    "evidence:reviews:lab4": "node scripts/collect-lab4-review-evidence.mjs",
    "test": "npm run test:quality:lab4",
    "test:server": "npm test --prefix server",
    "test:server:isolated": "node scripts/run-lab4-isolated-server.mjs",
    "test:performance:lab4": "node scripts/run-lab4-isolated-server.mjs tests/lab-04/dashboard-performance.test.ts",
    "test:client": "npm test --prefix client",
    "test:e2e": "playwright test",
    "test:e2e:lab4": "playwright test --config playwright.lab4.config.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:lab4",
    "test:e2e:headed": "playwright test --headed",
    "build": "npm run build --prefix server && npm run typecheck --prefix client && npm run build --prefix client",
    "test:quality:lab4": "npm run test:client && npm run test:server:isolated && npm run build && npm run test:e2e:all"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.2.1"
  }
}
